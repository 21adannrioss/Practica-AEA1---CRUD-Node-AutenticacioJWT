<%- include('includes/header') %>
<section class="targeta">
  <h1>Zona privada</h1>
  <p>Hola <strong><%= usuari.usuari %></strong>! Aquesta pàgina només la pots veure si has iniciat sessió.</p>
  <p>Rol: <span class="etiqueta etiqueta-<%= usuari.rol %>"><%= usuari.rol %></span></p>
</section>

<section class="targeta">
  <h2>Llibres</h2>
  <p>Només pots modificar i esborrar els teus llibres<% if (usuari.rol === 'admin') { %>, però com a admin pots fer-ho amb tots<% } %>.</p>
  <table>
    <thead><tr><th>Títol</th><th>Autor</th><th>Any</th><th>Propietari</th><th></th></tr></thead>
    <tbody>
      <% llibres.forEach((llibre) => { %>
        <tr>
          <td><%= llibre.titol %></td>
          <td><%= llibre.autor %></td>
          <td><%= llibre.any %></td>
          <td><%= llibre.propietari %></td>
          <td class="accions">
            <% if (usuari.rol === 'admin' || llibre.propietariId === usuari.id) { %>
              <button class="secundari editar-llibre" data-id="<%= llibre.id %>" data-titol="<%= llibre.titol %>" data-autor="<%= llibre.autor %>" data-any="<%= llibre.any %>">Editar</button>
              <button class="perill esborrar-llibre" data-id="<%= llibre.id %>">Esborrar</button>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<section class="targeta">
  <form id="formulari-llibre">
    <h2 id="titol-formulari">Afegir un llibre</h2>
    <input type="hidden" id="llibre-id">
    <div class="dues-columnes">
      <div>
        <label for="llibre-titol">Títol</label>
        <input type="text" id="llibre-titol" required>
      </div>
      <div>
        <label for="llibre-autor">Autor</label>
        <input type="text" id="llibre-autor" required>
      </div>
      <div>
        <label for="llibre-any">Any</label>
        <input type="number" id="llibre-any" required>
      </div>
    </div>
    <button type="submit" id="boto-desar">Afegir llibre</button>
    <button type="button" class="secundari" id="boto-cancelar" hidden>Cancel·lar</button>
    <span class="missatge">&nbsp;</span>
  </form>
</section>
<%- include('includes/footer') %>
<script src="/js/llibres.js"></script>
</body>
</html>
